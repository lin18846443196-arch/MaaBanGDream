<Project>
  <!-- 仅覆盖桌面入口；核心库和更新器保留原程序集名称以保持兼容。 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MFAAvalonia.Desktop'">
    <AssemblyName>RhythmPilot</AssemblyName>
    <OutputName>RhythmPilot</OutputName>
    <AssemblyTitle>RhythmPilot</AssemblyTitle>
    <Product>RhythmPilot</Product>
    <ApplicationIcon>$(MSBuildThisFileDirectory)rhythmpilot.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MFAUpdater'">
    <Product>RhythmPilot</Product>
    <ApplicationIcon>$(MSBuildThisFileDirectory)rhythmpilot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MFAUpdater'">
    <EmbeddedResource Remove="logo.ico" />
    <EmbeddedResource Remove="..\MFAAvalonia\Assets\maabangdream-icon.png" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)rhythmpilot.ico" LogicalName="MFAUpdater.logo.ico" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\docs\assets\rhythmpilot-logo.png" LogicalName="MFAUpdater.brand.png" />
  </ItemGroup>
</Project>
